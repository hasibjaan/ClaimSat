# Copy to api/.env and fill in. Never commit api/.env.
GCP_PROJECT=your-gcp-project-id
GCP_REGION=asia-south1
VERTEX_LOCATION=us-central1
# Check the current Gemini Flash model name in the Vertex AI Model Garden.
GEMINI_MODEL=gemini-2.5-flash
GCS_BUCKET=your-gcp-project-id-claimsat
BQ_DATASET=claimsat
DEMO_MODE=false
# Code officers enter to open the dashboard and register plots. Use a long random value.
OFFICER_ACCESS_CODE=change-me
